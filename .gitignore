# ---- Backend runtime files (keep the folders, ignore their contents) ----
# Must stay after the generic `logs/` rule above so the re-include works.
backend/uploads/*
!backend/uploads/.gitkeep
!backend/logs/
backend/logs/*
!backend/logs/.gitkeep

# ---- Frontend local config (backend base URL is secret; repo is public) ----
frontend/**/Config.xcconfig
frontend/**/Config.swift

# ---- Deploy config (holds secrets) and the env files deploy.sh writes from it ----
backend/deploy.yaml
backend/.deploy/
