ANTHROPIC_API_KEY=
SERPAPI_KEY=
STRIPE_SECRET_KEY=
PUBLIC_BASE_URL=https://<subdomain>.ngrok-free.app
# segmentation server (path prefix included) and its Cloudflare Access service token
MODEL_SERVICE_URL=https://<segmentation-host>/inference
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# CLIP /embed service (not built yet): its URL and bearer token
EMBED_SERVICE_URL=
MODEL_SERVICE_TOKEN=
ROBOFLOW_API_KEY=
# one vision call at server start (under a cent) so the first real request is fast; set false while
# editing with --reload to skip it
WARMUP=true
# an object on screen this long gets a quick label, then a Look; MAX_LOOKS run at once
QUICK_LABEL_DWELL_MS=500
LOOK_DWELL_MS=500
MAX_LOOKS=3
# WebRTC (rtc/legacy_webrtc.py): a Cloudflare TURN key (dashboard: Realtime > TURN), so a phone on another network
# can connect; or static TURN_URLS (comma-separated), TURN_USERNAME, TURN_CREDENTIAL; else STUN only
CF_TURN_KEY_ID=
CF_TURN_KEY_API_TOKEN=
# degrees to turn the phone's frames if they arrive sideways (90, 180, 270)
WEBRTC_ROTATE=0
# LiveKit Cloud: the session's room (POST /session/token) and the voice agent (voice/agent.py)
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Shopping and Amazon searches (search.py): OpenWeb Ninja when this is set, else SerpAPI.
# SHOPPING_PROVIDER / AMAZON_PROVIDER = openwebninja | serpapi override it.
OPENWEB_NINJA_API_KEY=
